      <path d="M7 8h4M7 11h2" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" />
      <path d="M8 20h8" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" />
    </svg>
  );
}

